{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "format",
  "room",
  "pack",
  "entities",
  "units"
 ],
 "properties": {
  "format": {
   "const": 1
  },
  "templates": {
   "type": "object",
   "propertyNames": {
    "pattern": "^\\^"
   }
  },
  "entities": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "components"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "extends": {
      "type": "string",
      "pattern": "^\\^"
     },
     "components": {
      "type": "object",
      "required": [
       "Transform"
      ],
      "propertyNames": {
       "pattern": "^-?[A-Z][A-Za-z]*(@[a-z_0-9]+)?$"
      },
      "properties": {
       "Transform": {
        "type": "object",
        "required": [
         "x",
         "y",
         "z"
        ],
        "properties": {
         "x": {
          "type": "integer"
         },
         "y": {
          "type": "integer"
         },
         "z": {
          "type": "integer"
         },
         "rotY": {
          "type": "number"
         },
         "rot": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "绕 x、y、z 的度数；只绕 y 时用 rotY。照暗黑 2 预设：植被与杂物有倾斜"
         },
         "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "等比缩放，默认 1；暗黑 2 预设里 60% 是 1，植被 0.5 到 0.8"
         },
         "q": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "四元数 [x, y, z, w]（预制体从 Blender 导出时用，避免欧拉角顺序之争）"
         },
         "s": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "三轴缩放"
         }
        }
       },
       "Prefab": {
        "type": "object",
        "required": [
         "file"
        ],
        "properties": {
         "file": {
          "type": "string",
          "description": "packs/<包>/prefabs/<名>.json，实体表坐标相对本实体"
         }
        },
        "description": "预制体放置：一顶帐篷 = 帆布 + 杆 + 木板 + 桶 + 草 + 泥地 + 灯，几十个实体打成一个包放一次（暗黑 2 PrefabPlacement）"
       },
       "Variation": {
        "type": "object",
        "required": [
         "options"
        ],
        "properties": {
         "options": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "object",
           "required": [
            "model",
            "weight"
           ],
           "properties": {
            "model": {
             "type": "string"
            },
            "weight": {
             "type": "number",
             "minimum": 0
            }
           }
          }
         },
         "seed": {
          "type": "integer"
         }
        },
        "description": "按权重选一个模型（暗黑 2 ModelVariation）"
       },
       "Light": {
        "type": "object",
        "properties": {
         "kind": {
          "enum": [
           "point",
           "spot"
          ]
         },
         "color": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
         },
         "power": {
          "type": "number"
         },
         "radius": {
          "type": "integer",
          "description": "厘米"
         },
         "angle": {
          "type": "number"
         },
         "attenuation": {
          "type": "number"
         },
         "shadow": {
          "type": "boolean"
         },
         "fromObject": {
          "type": "boolean"
         },
         "periods": {
          "type": "array",
          "items": {
           "enum": [
            "dawn",
            "day",
            "dusk",
            "night"
           ]
          },
          "description": "哪些时段亮；不写就全时段"
         },
         "emissive": {
          "type": "boolean",
          "description": "同一实体的模型跟着亮（灯笼纸）"
         }
        }
       },
       "Vfx": {
        "type": "object",
        "required": [
         "file"
        ],
        "properties": {
         "file": {
          "type": "string"
         }
        },
        "description": "雾、薄霭、飞虫、篝火火焰这类粒子实体，单独摆（暗黑 2 一座城摆了 105 个）"
       },
       "Audio": {
        "type": "object",
        "required": [
         "event"
        ],
        "properties": {
         "event": {
          "type": "string"
         },
         "randomDelay": {
          "type": "number"
         }
        },
        "description": "环境音源：风吹树、水声（暗黑 2 一座城 171 个）"
       },
       "Stamp": {
        "type": "object",
        "required": [
         "mask",
         "layer"
        ],
        "properties": {
         "mask": {
          "type": "string"
         },
         "layer": {
          "type": "integer"
         },
         "strength": {
          "type": "number"
         }
        },
        "description": "地形印章：用遮罩把一块地改成某个地面层（河床、空地、篝火圈）"
       },
       "Decal": {
        "type": "object",
        "required": [
         "alb"
        ],
        "properties": {
         "alb": {
          "type": "string"
         },
         "nrm": {
          "type": "string"
         },
         "orm": {
          "type": "string"
         },
         "fade": {
          "type": "number"
         }
        },
        "description": "投影贴花：鸟粪、污渍、压痕、车辙（暗黑 2 一顶帐篷 17 个）"
       },
       "Model": {
        "type": "object",
        "properties": {
         "file": {
          "type": "string"
         },
         "tier": {
          "type": "integer"
         },
         "castShadow": {
          "type": "boolean"
         },
         "floor": {
          "type": "boolean",
          "description": "贴地网格（压实泥、草皮、灰烬），与地面混合不投影，暗黑 2 的 floorModel"
         },
         "wallFade": {
          "type": "boolean",
          "description": "挡住角色时整段淡出（暗黑 2 WallTransparency）"
         }
        }
       },
       "Tier": {
        "type": "object",
        "properties": {
         "visible": {
          "type": "integer",
          "minimum": -1,
          "maximum": 3,
          "description": "-1 永远显示，0 低档起，1 中档起……暗黑 2 的 visibilityTier"
         },
         "shadow": {
          "type": "integer",
          "minimum": -1,
          "maximum": 3
         }
        }
       },
       "Ground": {
        "type": "object",
        "required": [
         "size",
         "mask",
         "layers"
        ],
        "description": "地面分层（营地小试，技术卡十四）：一张 RGB 分层图（R 草、G 潮暗、B 路）混两层平铺材质",
        "properties": {
         "size": {
          "type": "integer"
         },
         "mask": {
          "type": "string"
         },
         "damp": {
          "type": "number"
         },
         "layers": {
          "type": "array",
          "minItems": 2,
          "items": {
           "type": "object",
           "required": [
            "alb",
            "tiling"
           ],
           "properties": {
            "name": {
             "type": "string"
            },
            "alb": {
             "type": "string"
            },
            "nrm": {
             "type": "string"
            },
            "tiling": {
             "type": "integer",
             "description": "一铺多少厘米"
            }
           }
          }
         },
         "extent": {
          "type": "integer",
          "description": "地面实际铺多大（厘米）；分层图只管中间 size，外圈沿用边缘值"
         }
        }
       },
       "Scatter": {
        "type": "object",
        "required": [
         "file",
         "models"
        ],
        "description": "散布（技术卡十四）：散布表与分层图同源同种子，同种物件一个实例网格",
        "properties": {
         "file": {
          "type": "string"
         },
         "axes": {
          "enum": [
           "blender",
           "three"
          ],
          "description": "表里坐标的轴向；blender = (x, y) 平面，换算成 three 的 (x, -y)"
         },
         "models": {
          "type": "object",
          "additionalProperties": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "units": {
   "const": "cm"
  },
  "prefabs": {
   "type": "object",
   "description": "可选：内联预制体 {名: {entities:[...]}}；外置的放 packs/<包>/prefabs/"
  },
  "dependencies": {
   "type": "object",
   "description": "可选：预载清单（模型、贴图、音效），由 tables_check 生成而不是手写"
  }
 }
}
